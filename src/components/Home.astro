    .phone-frame { position: relative; aspect-ratio: 480 / 953; border-radius: 34px; border: 10px solid #1E1A16; background: #1E1A16; overflow: hidden; box-shadow: 0 30px 60px -24px rgba(30, 26, 22, .45); cursor: pointer; transform: rotate(2deg); }
    .phone-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .5s ease; }
    .phone-frame img.on { opacity: 1; }
    @media (prefers-reduced-motion: reduce) { .phone-frame { transform: none; } .phone-frame img { transition: none; } }
    .phone figcaption { margin-top: 14px; font-size: 15px; color: var(--ink-2); font-weight: 600; }

    .nums { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--card); }
    .nums ul { list-style: none; margin: 0; padding: 20px 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
    .nums li { display: flex; flex-direction: column; gap: 2px; padding: 0 8px; border-left: 3px solid var(--haldi); }
    .nums b { font: 800 clamp(22px, 2.6vw, 30px)/1.1 var(--serif); }
    .nums span { font-size: 15px; color: var(--ink-2); line-height: 1.3; }
    @media (max-width: 900px) { .nums ul { grid-template-columns: repeat(3, 1fr); row-gap: 18px; } }
    @media (max-width: 480px) { .nums ul { grid-template-columns: repeat(2, 1fr); } }

    .pain h3 { font-size: 20px; font-style: italic; color: var(--chai-2); }

    .day { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; counter-reset: d; }
    @media (max-width: 1000px) { .day { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 600px) { .day { grid-template-columns: 1fr; } }
    .day li { display: flex; flex-direction: column; gap: 10px; }
    .day .card { flex: 1; display: flex; flex-direction: column; }
    .when { font: 700 14px/1 var(--sans); letter-spacing: .06em; text-transform: uppercase; color: var(--chai); }
    html[lang="hi"] .when { letter-spacing: 0; font-size: 15px; }
    .mini { margin-top: auto; display: flex; flex-direction: column; gap: 4px; background: var(--paper); border: 1px dashed var(--line-2); border-radius: 10px; padding: 12px; color: var(--ink); text-decoration: none; }
    a.mini:hover { border-color: var(--chai); color: var(--ink); }
    .mini b { font-size: 16px; line-height: 1.35; }
