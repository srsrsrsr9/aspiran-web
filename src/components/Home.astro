    .hero-grid { display: grid; grid-template-columns: 1.25fr .75fr; gap: 40px; align-items: center; }
    @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } .phone { max-width: 280px; margin: 0 auto; } }
    .hero h1 { font-size: clamp(40px, 6.4vw, 68px); }
