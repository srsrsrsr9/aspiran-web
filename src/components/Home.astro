const description = T(
  `The daily UPSC study app: revision that brings back what you studied before you forget it, Mains answers marked in minutes, ${fmt(pyqCount)} PYQs, current affairs, mocks and a small study pod. Free forever, in English and Hindi.`,
  `UPSC का रोज़ का स्टडी ऐप: रिवीज़न जो पढ़ा हुआ भूलने से पहले लौटाता है, मेन्स आंसर की जाँच मिनटों में, ${fmt(pyqCount)} PYQ, करंट अफ़ेयर्स, मॉक और एक छोटा स्टडी पॉड। हमेशा फ़्री, हिंदी और इंग्लिश में।`);
---

<SiteLayout title={title} description={description} lang={lang} alternates={{ en: '/', hi: '/hi/' }} jsonLd={[appLd, faqLd]} where="home"
  chotu={T("Hi, I'm Chotu. Tap the chips under the phone to see the app, or just join free. Takes a minute.", 'नमस्ते, मैं छोटू। फ़ोन के नीचे के बटन दबाकर ऐप देखिए, या सीधे फ़्री में जुड़िए। एक मिनट लगेगा।')}>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="kick">{T('UPSC CSE · Prelims · Mains · Interview', 'UPSC CSE · प्रीलिम्स · मेन्स · इंटरव्यू')}</p>
        <h1>{hi ? <>एक बार पढ़िए।<br /><span class="hl">एग्ज़ाम हॉल तक याद रहेगा।</span></> : <>Study once.<br /><span class="hl">Remember it</span> in the exam hall.</>}</h1>
        <p class="lede">{T('Revision that comes back before you forget, Mains answers marked in minutes, every PYQ, and a pod to prep with. In English and Hindi.',
          'भूलने से पहले लौटता रिवीज़न, मिनटों में मेन्स आंसर की जाँच, हर PYQ, और साथ पढ़ने को एक पॉड। हिंदी और इंग्लिश में।')}</p>
        <div class="ctas">
          <a class="btn primary big" href={join('hero')} data-cta="join" data-where="hero">{T('Join free', 'फ़्री में जुड़ें')}</a>
          <a class="btn ghost big" href={tourUrl('hero', lang)} data-cta="tour" data-where="hero">▶ {T('Watch the 6-min tour', '6 मिनट का टूर देखिए')}</a>
        </div>
        <ul class="ticks">{(hi ? ['हमेशा फ़्री', 'कोई कार्ड नहीं', 'हिंदी और English', 'किसी भी फ़ोन पर'] : ['Free forever', 'No card', 'English and हिंदी', 'On any phone']).map((x) => <li>{x}</li>)}</ul>
      </div>
      <Phones lang={lang} />
    </div>
  </section>

  <section class="nums" aria-label={T('What is in Aspiran today', 'आज Aspiran में क्या है')}>
    <div class="wrap"><ul>{NUMS.map(([n, l]) => <li><b>{n}</b><span>{l}</span></li>)}</ul></div>
  </section>

  <Garden lang={lang} />

  <section class="sec feats">
    <div class="wrap">
      <div class="sec-head center">
        <p class="kick">{T('Sound familiar?', 'जाना-पहचाना लगता है?')}</p>
        <h2>{T('Everything for the whole exam, in one app', 'पूरे एग्ज़ाम के लिए सब कुछ, एक ऐप में')}</h2>
      </div>
      {rows.map((r, i) => (
        <article class={`feat ${i % 2 ? 'flip' : ''}`} data-say={r.say}>
          <figure class="feat-shot"><img src={shot(r.shot, lang)} alt="" width="520" height="961" loading="lazy" decoding="async" /></figure>
          <div class="feat-text">
            <p class="pain">{r.pain}</p>
            <h3>{r.h}</h3>
            <ul class="ticks-list">{r.pts.map((x) => <li>{x}</li>)}</ul>
            {i === 4 && todayCard && (
              <a class="today" href={dayUrl(today!.day, lang)}><span class="small">{T("Today's first card", 'आज का पहला कार्ड')}</span><b>{todayCard.headline}</b></a>
            )}
            <div class="ctas sm">
              <a class="btn primary" href={join(`feat-${r.shot}`)} data-cta="join" data-where={`feat-${r.shot}`}>{T('Join free', 'फ़्री में जुड़ें')}</a>
              {r.link && <a class="more" href={r.link[0]}>{r.link[1]} →</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  {pick && (
    <section class="sec tint" id="try-pyq">
      <div class="wrap narrow">
        <div class="sec-head center">
          <p class="kick">{T('Try it now · 30 seconds', 'अभी आज़माइए · 30 सेकंड')}</p>
          <h2>{T('One real PYQ. Answer it, and say how sure you are.', 'एक असली PYQ। जवाब दीजिए, और बताइए कितने पक्के हैं।')}</h2>
        </div>
        <PyqCard p={pick.p} q={pick.q} lang={lang} heading="h3" />
        <p class="center small"><a href={paperUrl(pick.p, lang)}>{T('The whole paper', 'पूरा पेपर')}</a> · <a href={pyqHome(lang)}>{T(`All ${fmt(pyqCount)} PYQs`, `सभी ${fmt(pyqCount)} PYQ`)}</a></p>
      </div>
    </section>
  )}

  <section class="sec night tour" data-say={T("Six minutes, one topic, start to finish. It ends with Join free, and I hope you will.", 'छह मिनट, एक टॉपिक, शुरू से अंत तक। आख़िर में "फ़्री में जुड़ें" आएगा, उम्मीद है आप जुड़ेंगे।')}>
    <div class="wrap tour-grid">
      <div>
        <p class="kick" style="color:#E9B13A">{T('See all of it first', 'पहले सब देख लीजिए')}</p>
        <h2>{T('Take the 6-minute tour of one topic', 'एक टॉपिक का 6 मिनट का टूर')}</h2>
        <p class="mute">{T('Federalism, from the first guess to the PYQs, the answer desk and your pod. Tap through at your pace. No sign-up to watch.',
          'फ़ेडरलिज़्म, पहले अंदाज़े से PYQ, आंसर की जाँच और आपके पॉड तक। अपनी रफ़्तार से देखिए। देखने के लिए साइन-अप नहीं।')}</p>
        <div class="ctas"><a class="btn primary big" href={tourUrl('tour-band', lang)} data-cta="tour" data-where="tour-band">▶ {T('Start the tour', 'टूर शुरू करें')}</a></div>
      </div>
      <div class="tour-shots" aria-hidden="true">
        {(['guess', 'sort', 'mains', 'chotu'] as Shot[]).map((s) => <img src={shot(s, lang)} alt="" width="520" height="961" loading="lazy" decoding="async" />)}
      </div>
    </div>
  </section>

  <section class="sec" data-say={T("Keep your coaching. I just make sure it stays in your head till exam day.", 'कोचिंग चालू रखिए। मैं बस ये पक्का करता हूँ कि पढ़ा हुआ एग्ज़ाम तक दिमाग़ में रहे।')}>
    <div class="wrap">
      <div class="sec-head"><h2>{T("Keep your coaching. Aspiran makes it count.", 'कोचिंग चालू रखिए। Aspiran उसे काम का बनाता है।')}</h2></div>
      <div class="table" role="table" aria-label={T('Aspiran next to coaching and YouTube', 'कोचिंग और YouTube के साथ Aspiran')}>
        <div class="tr head" role="row"><span role="columnheader"></span>{fit.cols.map((c, i) => <span role="columnheader" class={i === 2 ? 'us' : ''}>{c}</span>)}</div>
        {fit.rows.map(([k, a, b, c]) => (
          <div class="tr" role="row"><span role="rowheader">{k}</span><span role="cell" data-h={fit.cols[0]}>{a}</span><span role="cell" data-h={fit.cols[1]}>{b}</span><span role="cell" class="us" data-h={fit.cols[2]}>{c}</span></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Price: ₹3,999 a year, no founding offer (owner, 17 Nov 2026). -->
  <section class="sec tint" id="price" data-say={T("Start free. If answer checking clicks for you, Plus is about ₹11 a day.", 'फ़्री से शुरू कीजिए। आंसर की जाँच पसंद आए, तो Plus लगभग ₹11 रोज़ का है।')}>
    <div class="wrap">
      <div class="sec-head center"><h2>{T('Free forever. Plus when you want more.', 'हमेशा फ़्री। और चाहिए तो Plus।')}</h2></div>
      <div class="grid two price">
        <div class="card main">
          <p class="kick">{T('Free · free forever', 'फ़्री · हमेशा फ़्री')}</p>
          <p class="amount">₹0</p>
          <ul class="ticks-list">{(hi ? ['रोज़ का रिवीज़न और करंट अफ़ेयर्स', 'सारे नोट्स, PYQ और वीडियो', 'हफ़्ते में 3 आंसर की जाँच, महीने में 1 मॉक', 'आपका पॉड और स्टडी रूम', 'डाउट के लिए छोटू']
            : ['Daily revision and current affairs', 'All notes, PYQs and videos', '3 answers checked a week, 1 mock a month', 'Your pod and study room', 'Chotu for everyday doubts']).map((x) => <li>{x}</li>)}</ul>
          <a class="btn primary big" href={join('price-free')} data-cta="join" data-where="price">{T('Join free', 'फ़्री में जुड़ें')}</a>
          <p class="small" style="margin-top:10px">{T('No card. Takes a minute.', 'कोई कार्ड नहीं। एक मिनट लगेगा।')}</p>
        </div>
        <div class="card">
          <p class="kick">Plus</p>
          <p class="amount">₹3,999<span>{T(' a year', ' साल')}</span></p>
          <p class="small">{T('About ₹11 a day. Less than one week of a Delhi classroom course.', 'लगभग ₹11 रोज़। दिल्ली के क्लासरूम कोर्स के एक हफ़्ते से भी कम।')}</p>
          <ul class="ticks-list">{(hi ? ['अनलिमिटेड आंसर की जाँच और रीराइट', 'सारे 35 मॉक, आपकी ग़लतियों के टाइप के साथ', '3 फ़ोटो से एसे की जाँच', 'छोटू से और ज़्यादा मदद']
            : ['Unlimited answer checking and rewrites', 'All 35 mocks, with your mistake types', 'Essays marked from 3 photos', 'More help from Chotu']).map((x) => <li>{x}</li>)}</ul>
          <a class="btn ghost" href={`${joinUrl('plus', lang)}#plus`} data-cta="plus" data-where="price">{T('Get Plus', 'Plus लीजिए')}</a>
          <p class="small" style="margin-top:12px">{T('UPI, card or net banking. One payment, no auto-renewal, refund within 7 days. ', 'UPI, कार्ड या नेट बैंकिंग। एक बार का पेमेंट, अपने-आप रिन्यू नहीं, 7 दिन में रिफ़ंड। ')}
            <a href={WA_PAY} target="_blank" rel="noopener" data-cta="whatsapp" data-where="price">{T('Or pay by UPI on WhatsApp', 'या WhatsApp पर UPI से')}</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" data-say={T("Two minutes each, and every one is on the syllabus. Careful, they're hard to stop.", 'हर एक दो मिनट का, और हर एक सिलेबस से। ध्यान रहे, रुकना मुश्किल है।')}>
    <div class="wrap">
      <div class="sec-head">
        <p class="kick">{T(`Binge · ${shortsIn(lang).length} two-minute stories`, `बिंज · दो मिनट की ${shortsIn(lang).length} कहानियाँ`)}</p>
        <h2>{T('Scroll like it\'s your feed. Learn like it\'s the syllabus.', 'फ़ीड की तरह स्क्रॉल कीजिए। सिलेबस की तरह सीखिए।')}</h2>
      </div>
      <div class="shelf-row">{starters(lang).slice(0, 8).map((s) => <ShortTile s={s} lang={lang} />)}</div>
      <p><a class="btn primary" href={`${P}/binge/`}>▶ {T('Open Binge', 'बिंज खोलिए')}</a></p>
    </div>
  </section>

  <section class="sec" data-say={T("All of this is free to read. In the app, it also comes back to you before you forget it.", 'ये सब फ़्री में पढ़ सकते हैं। ऐप में ये भूलने से पहले आपके पास लौटकर भी आता है।')}>
    <div class="wrap">
      <div class="sec-head">
        <p class="kick">{T('Free · no sign-up to read', 'फ़्री · पढ़ने के लिए साइन-अप नहीं')}</p>
        <h2>{T('Start reading free, right now', 'अभी फ़्री में पढ़ना शुरू कीजिए')}</h2>
      </div>
      <div class="free-tiles">
        {free.map(([href, name, n]) => <a class="card tile" href={href}><b>{name}</b><span>{n}</span></a>)}
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <a class="coach" href={`${P}/for-coaching/`} data-cta="coaching" data-where="home">
        <span><b>{T('Run a coaching institute or study library?', 'कोचिंग इंस्टिट्यूट या स्टडी लाइब्रेरी चलाते हैं?')}</b> {T('Give your students Aspiran, with your name on it.', 'अपने स्टूडेंट्स को Aspiran दीजिए, आपके नाम के साथ।')}</span>
        <span class="more">{T('See how', 'देखिए कैसे')} →</span>
      </a>
    </div>
  </section>

  <section class="sec tint">
    <div class="wrap narrow">
      <h2>{T('Questions aspirants ask', 'अभ्यर्थी जो पूछते हैं')}</h2>
      {faq.map(([q, a]) => <details class="faq"><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <section class="sec end" data-no-dock>
    <div class="wrap narrow" style="text-align:center">
      <div class="end-chotu"><ChotuFace size={110} /></div>
      <p class="end-say">{T('"Join free. I\'ll take care of the remembering."', '"फ़्री में जुड़िए। याद रखवाने का काम मेरा।"')}</p>
      <h2>{T('Your prep, remembered till exam day.', 'आपकी तैयारी, एग्ज़ाम के दिन तक याद।')}</h2>
      <div class="ctas" style="justify-content:center">
        <a class="btn primary big" href={join('end')} data-cta="join" data-where="end">{T('Join free', 'फ़्री में जुड़ें')}</a>
        <a class="btn ghost big" href={tourUrl('end', lang)} data-cta="tour" data-where="end">▶ {T('6-min tour', '6 मिनट का टूर')}</a>
      </div>
      <p class="small">{T('Free forever · no card · English and हिंदी', 'हमेशा फ़्री · कोई कार्ड नहीं · हिंदी और English')}</p>
      <form class="later" id="later" novalidate>
        <label for="later-in">{T("On someone else's phone? Leave your email and we'll send you the link.", 'किसी और के फ़ोन पर हैं? ईमेल डाल दीजिए, हम लिंक भेज देंगे।')}</label>
        <div class="field-row"><input id="later-in" type="email" autocomplete="email" maxlength="80" placeholder="you@example.com" />
          <input type="text" name="company" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <button class="btn ghost" type="submit">{T('Send it', 'भेजिए')}</button></div>
        <p class="small">{T('One email with the link. By sending, you agree we can email you about Aspiran. ', 'लिंक वाला एक ईमेल। भेजकर आप मानते हैं कि हम Aspiran के बारे में ईमेल कर सकते हैं। ')}<a href="/privacy">{T('Privacy', 'प्राइवेसी')}</a>.</p>
        <p class="out" id="later-out" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <style>
    .hero { padding: 40px 0 36px; overflow: hidden; background:
      radial-gradient(900px 420px at 85% 10%, color-mix(in srgb, var(--haldi) 18%, transparent), transparent 70%),
      radial-gradient(700px 380px at 0% 100%, color-mix(in srgb, var(--chai) 12%, transparent), transparent 70%); }
    .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; }
    .hero h1 { font-size: clamp(40px, 5.8vw, 66px); }
    .hero .lede { font-size: 20px; max-width: 30em; }
    .btn.big { font-size: 18px; padding: 15px 24px; }
    @media (max-width: 860px) { .hero-grid { grid-template-columns: 1fr; } .hero-text { text-align: left; } .hero .lede { font-size: 18px; } }

    .nums { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--card); }
    .nums ul { list-style: none; margin: 0; padding: 20px 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
    .nums li { display: flex; flex-direction: column; gap: 2px; padding: 0 8px; border-left: 3px solid var(--haldi); }
    .nums b { font: 800 clamp(22px, 2.6vw, 30px)/1.1 var(--serif); }
    .nums span { font-size: 15px; color: var(--ink-2); line-height: 1.3; }
    @media (max-width: 900px) { .nums ul { grid-template-columns: repeat(3, 1fr); row-gap: 18px; } }
    @media (max-width: 480px) { .nums ul { grid-template-columns: repeat(2, 1fr); } }

    .sec-head.center { text-align: center; margin-left: auto; margin-right: auto; }
    .center { text-align: center; }
    .feat { display: grid; grid-template-columns: 300px 1fr; gap: 56px; align-items: center; max-width: 960px; margin: 0 auto 72px; }
    .feat.flip { grid-template-columns: 1fr 300px; }
    .feat.flip .feat-shot { order: 2; }
    .feat-shot { margin: 0; aspect-ratio: 520 / 961; max-height: 520px; border-radius: 30px; border: 9px solid #1E1A16; background: #1E1A16; overflow: hidden; box-shadow: 0 30px 60px -28px rgba(30, 26, 22, .55); transform: rotate(-2deg); }
    .feat.flip .feat-shot { transform: rotate(2deg); }
    .feat-shot img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pain { font: italic 600 19px/1.4 var(--serif); color: var(--chai-2); margin: 0 0 10px; }
    .feat h3 { font-size: clamp(26px, 3vw, 36px); line-height: 1.15; margin: 0 0 14px; }
    .feat .ticks-list { margin-bottom: 18px; }
    .ctas.sm { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
    .more { font-weight: 700; color: var(--chai-2); text-decoration: none; }
    .today { display: flex; flex-direction: column; gap: 2px; border: 1px dashed var(--line-2); border-radius: 12px; padding: 12px 14px; margin: 0 0 18px; color: var(--ink); text-decoration: none; background: var(--paper); }
    .today:hover { border-color: var(--chai); }
    @media (max-width: 760px) {
      .feat, .feat.flip { grid-template-columns: 1fr; gap: 22px; margin-bottom: 56px; }
      .feat.flip .feat-shot { order: 0; }
      .feat-shot { width: 210px; margin: 0 auto; }
    }

    .tour-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 40px; align-items: center; }
    .tour-shots { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .tour-shots img { width: 100%; height: auto; border-radius: 16px; border: 5px solid #2A2C38; }
    .tour-shots img:nth-child(even) { transform: translateY(24px); }
    @media (max-width: 860px) { .tour-grid { grid-template-columns: 1fr; } .tour-shots { grid-template-columns: repeat(4, 1fr); gap: 8px; } }

    .table { border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; background: var(--card); }
    .tr { display: grid; grid-template-columns: 1.1fr 1fr 1fr 1fr; border-top: 1px solid var(--line); }
    .tr:first-child { border-top: 0; }
    .tr > span { padding: 14px 16px; font-size: 16px; }
    .tr.head > span { font-weight: 700; background: var(--paper-2); }
    .tr [role="rowheader"] { font-weight: 700; }
    .tr .us { background: color-mix(in srgb, var(--haldi) 14%, var(--card)); font-weight: 600; }
    @media (max-width: 760px) {
      .tr.head { display: none; }
      .tr { grid-template-columns: 1fr; padding: 8px 0; }
      .tr > span { padding: 4px 16px; }
      .tr > span[data-h]::before { content: attr(data-h) ": "; color: var(--ink-3); font-weight: 500; }
    }

    .price .card { display: flex; flex-direction: column; }
    .price .card.main { border: 2px solid var(--chai); box-shadow: 0 20px 40px -24px color-mix(in srgb, var(--chai) 60%, transparent); }
    .price .amount { font: 800 44px/1.1 var(--serif); margin: 0 0 4px; }
    .price .amount span { font: 500 18px var(--sans); color: var(--ink-2); }
    .price .ticks-list { margin: 10px 0 20px; }
    .price .btn { align-self: flex-start; margin-top: auto; }

    .free-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .tile { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; padding: 16px 18px; text-decoration: none; color: var(--ink); }
    .tile b { font-size: 18px; }
    .tile span { color: var(--chai-2); font-weight: 700; font-size: 15px; white-space: nowrap; }
    .tile:hover { border-color: var(--chai); }
    @media (max-width: 860px) { .free-tiles { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 520px) { .free-tiles { grid-template-columns: 1fr; } }

    .coach { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; background: var(--night); color: var(--night-ink); border-radius: var(--r); padding: 18px 22px; text-decoration: none; }
    .coach .more { color: #E9B13A; }

    .end { padding-bottom: 72px; }
    .end-chotu { display: flex; justify-content: center; }
    .end-chotu svg { width: 110px; height: auto; }
    .end-say { font: italic 600 20px/1.4 var(--serif); color: var(--chai-2); margin: 8px 0 4px; }
    .end h2 { font-size: clamp(30px, 4vw, 44px); }
    .later { max-width: 560px; margin: 36px auto 0; text-align: left; }
    .later label { display: block; margin-bottom: 8px; color: var(--ink-2); }
  </style>

  <script>
    const HI = document.documentElement.lang === 'hi';
    const ph = (name: string, props: Record<string, unknown> = {}) => (window as any).posthog?.capture?.(name, props);
    // "Send me the link": /web/lead on the app server emails the link at once.
    const store = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private window */ } } };
    const visitorId = store.get('aspiran-vid') ?? `v-${crypto.getRandomValues(new Uint32Array(3)).join('-')}`;
    store.set('aspiran-vid', visitorId);
    const API = /^(localhost|127\.0\.0\.1)$/.test(location.hostname) ? 'http://localhost:8788' : 'https://app.aspiran.in';
    const u = new URL(location.href);
    const source = ['utm_source', 'utm_medium', 'utm_campaign'].map((k) => u.searchParams.get(k)).filter(Boolean).join('/') || (document.referrer ? new URL(document.referrer).hostname : 'direct');
    document.getElementById('later')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      const out = document.getElementById('later-out')!;
      const contact = (document.getElementById('later-in') as HTMLInputElement).value.trim();
      if (!/^\S+@\S+\.\S+$/.test(contact)) { out.textContent = HI ? 'ईमेल डालिए।' : 'Add an email address.'; return; }
      out.textContent = HI ? 'भेज रहे हैं…' : 'Sending…';
      try {
        const r = await fetch(`${API}/web/lead`, { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ visitorId, details: {}, contact, consent: true, lang: HI ? 'hi' : 'en', source, company: (f.elements.namedItem('company') as HTMLInputElement).value }) });
        if (!r.ok) throw new Error();
        out.textContent = HI ? 'भेज दिया। अपना इनबॉक्स देखिए।' : 'Sent. Check your inbox.';
        ph('lead_saved', { kind: 'email' });
      } catch { out.textContent = HI ? 'अभी नहीं भेज पाए। ऊपर वाला बटन सीधे ऐप खोलता है।' : "Couldn't send just now. The button above opens the app directly."; }
    });
  </script>
</SiteLayout>
