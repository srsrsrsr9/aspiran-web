  ['क्या यह मुफ़्त है?', 'हाँ। रोज़ का रिवीज़न, करेंट अफ़ेयर्स, नोट्स, PYQ, पॉड, हफ़्ते में 3 उत्तरों की जाँच और महीने में 1 मॉक मुफ़्त हैं, हमेशा के लिए। Plus (₹3,999 साल) में असीमित उत्तर-जाँच और सारे मॉक।'],
  ['मेरे उत्तर कैसे जाँचे जाते हैं?', 'पहले आप ख़ुद, हर हिस्से पर। फिर Aspiran का मार्कर उसे UPSC के एक आम अच्छे अंक वाले उत्तर से मिलाता है और पाँच हिस्सों पर बताता है कि आप नीचे हैं, बराबर हैं या ऊपर, साथ में हर हिस्से का एक सुधार। यह ग़लत हो सकता है; इसीलिए पहले आप ख़ुद अंक देते हैं।'],
  ['क्या हिंदी माध्यम के लिए ठीक है?', 'हाँ। ऐप, नोट्स, अभ्यास, करेंट अफ़ेयर्स और उत्तर जाँच हिंदी में हैं, और अंग्रेज़ी–हिंदी शब्दावली भी। कुछ वीडियो अभी अंग्रेज़ी में हैं।'],
  ['यह प्रीलिम्स के लिए है या मेन्स के लिए?', 'दोनों, और इंटरव्यू भी। प्रीलिम्स: रोज़ का रिवीज़न, असली PYQ, "कितने पक्के हैं?" से नेगेटिव मार्किंग की समझ, मॉक, CSAT। मेन्स: उत्तर लेखन, जाँच, निबंध, एथिक्स केस। फिर इंटरव्यू की मॉक बातचीत।'],
  ['फ़ोन पर चलेगा?', 'हाँ। वेब ऐप किसी भी फ़ोन या लैपटॉप के ब्राउज़र में चलता है, कुछ इंस्टॉल नहीं करना। Android ऐप Google Play पर टेस्टिंग में है।'],
  ['भुगतान कैसे करूँ?', 'ऐप में Plus खोलिए: UPI, कार्ड या नेट बैंकिंग। एक बार का भुगतान, अपने-आप रिन्यू नहीं, 7 दिन में रिफ़ंड।'],
] : [
  ['What is Aspiran?', 'A daily study app for UPSC aspirants: revision that stops you forgetting, Mains answers checked in minutes, daily current affairs, PYQs, mocks, notes, and a small study group (a pod). In English and Hindi.'],
  ['I already go to coaching, or study from YouTube. Why this too?', 'Coaching teaches it once. Aspiran makes it stay: 15 minutes a day of revision on what you have already studied, and answer writing that gets checked in minutes. It works alongside coaching, not instead of it.'],
  ['Is it free?', 'Yes. Daily revision, current affairs, notes, PYQs, your pod, 3 answers checked a week and 1 mock a month are free, for good. Plus (₹3,999 a year) adds unlimited answer checking and all mocks.'],
  ['How are my answers marked?', 'By you first, part by part. Then Aspiran\'s marker compares it with a typical well-scoring UPSC answer and tells you, on five parts, whether you are below, at or above it, with one fix for each. It can be wrong, which is why you mark your own first.'],
  ['Does it work for Hindi medium?', 'Yes. The app, notes, practice, current affairs and answer checking are in Hindi, and there is an English–Hindi glossary. Some videos are in English for now.'],
  ['Is it for Prelims or Mains?', 'Both, and the interview. Prelims: daily revision, real PYQs, "how sure are you?" so negative marking stops surprising you, mocks and CSAT. Mains: answer writing and checking, essays, ethics cases. Then practice interview conversations.'],
  ['Does it work on my phone?', 'Yes. The web app runs in the browser on any phone or laptop, nothing to install. The Android app is in testing on Google Play.'],
  ['How do I pay?', 'Open Plus in the app: UPI, card or net banking. One payment, no auto-renewal, refund within 7 days.'],
];
const faqLd = { '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
const appLd = { '@type': 'WebApplication', name: 'Aspiran', url: 'https://app.aspiran.in/app/', applicationCategory: 'EducationalApplication', operatingSystem: 'Any (web), Android',
  inLanguage: ['en-IN', 'hi-IN'], offers: [{ '@type': 'Offer', price: '0', priceCurrency: 'INR', name: 'Free' }, { '@type': 'Offer', price: '3999', priceCurrency: 'INR', name: 'Plus, one year' }] };

const popular = pagesIn('notes', lang).filter((p) => /federal|preamble|fundamental rights|monsoon|monetary|parliament|governor|inflation|emergency|panchayat/i.test(p.title.en)).slice(0, 6);
const frames = pagesIn('mains-answer-writing', lang).slice(0, 3);
const title = T('Aspiran: UPSC prep app for revision, answer writing and current affairs, in English and Hindi',
  'Aspiran: UPSC तैयारी का ऐप, रिवीज़न, उत्तर लेखन और करेंट अफ़ेयर्स, हिंदी और अंग्रेज़ी में');
const description = T(
  'The daily UPSC study app: revision that brings back what you studied before you forget it, Mains answers checked in minutes, current affairs, PYQs 2016–2026, mocks and a small study group. Works with any coaching. Free to start, in English and Hindi.',
  'UPSC का रोज़ का स्टडी ऐप: रिवीज़न जो पढ़ा हुआ भूलने से पहले लौटाता है, मेन्स उत्तरों की जाँच मिनटों में, करेंट अफ़ेयर्स, PYQ 2016–2026, मॉक और एक छोटा स्टडी ग्रुप। किसी भी कोचिंग के साथ। मुफ़्त शुरुआत, हिंदी और अंग्रेज़ी में।');
---

<SiteLayout title={title} description={description} lang={lang} alternates={{ en: '/', hi: '/hi/' }} jsonLd={[appLd, faqLd]}>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kick">{T('UPSC CSE · Prelims · Mains · Interview', 'UPSC CSE · प्रीलिम्स · मेन्स · इंटरव्यू')}</p>
        <h1>{hi ? <>एक बार पढ़िए।<br /><span class="hl">परीक्षा हॉल में याद रहे।</span></> : <>Study once.<br /><span class="hl">Remember it</span> in the exam hall.</>}</h1>
        <p class="lede">{T(
          'Aspiran is the daily study app for UPSC. It brings back what you have studied before you forget it, checks your Mains answers in minutes, and gives you a small group to study with. Works with any coaching, YouTube or self-study.',
          'Aspiran, UPSC का रोज़ का स्टडी ऐप है। जो आपने पढ़ा, उसे भूलने से पहले वापस लाता है, आपके मेन्स उत्तर मिनटों में जाँचता है, और साथ पढ़ने के लिए एक छोटा ग्रुप देता है। किसी भी कोचिंग, YouTube या सेल्फ़-स्टडी के साथ।')}</p>
        <div class="ctas">
          <a class="btn primary" href={app('hero')} data-cta="try" data-where="hero">{T('Try a free topic', 'एक टॉपिक मुफ़्त आज़माइए')}</a>
          {today && <a class="btn ghost" href={dayUrl(today.day, lang)} data-cta="ca" data-where="hero">{T('Read today\'s current affairs', 'आज के करेंट अफ़ेयर्स पढ़िए')}</a>}
        </div>
        <ul class="ticks">{(hi ? ['मुफ़्त शुरुआत', 'आज़माने के लिए साइन-अप नहीं', 'हिंदी और English', 'किसी भी फ़ोन पर'] : ['Free to start', 'No sign-up to try', 'English and हिंदी', 'On any phone']).map((t) => <li>{t}</li>)}</ul>
      </div>
      <figure class="phone" aria-label={T('Screens from the free topic', 'मुफ़्त टॉपिक के स्क्रीन')}>
        <div class="phone-frame">
          {shots.map(([src, cap], i) => <img src={src} alt={cap} width="480" height="953" decoding="async" loading={i === 0 ? 'eager' : 'lazy'} class={i === 0 ? 'on' : ''} />)}
        </div>
        <figcaption id="phone-cap">{shots[0][1]}</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. What's inside, counted -->
  <section class="nums" aria-label={T('What is in Aspiran today', 'आज Aspiran में क्या है')}>
    <div class="wrap"><ul>{NUMS.map(([n, l]) => <li><b>{n}</b><span>{l}</span></li>)}</ul></div>
  </section>

  <!-- 3. The three things every aspirant says -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2>{T('Sound familiar?', 'जाना-पहचाना लगता है?')}</h2>
        <p>{T('Most aspirants don\'t fail for lack of material. They have too much of it, forget most of it, and practise alone.', 'ज़्यादातर अभ्यर्थी सामग्री की कमी से नहीं चूकते। सामग्री बहुत है, ज़्यादातर भूल जाते हैं, और अभ्यास अकेले करते हैं।')}</p>
      </div>
      <div class="grid">{pains.map(([q, a]) => <div class="card pain"><h3>{q}</h3><p class="mute">{a}</p></div>)}</div>
    </div>
  </section>

  <!-- 4. A day on Aspiran -->
  <section class="sec tint">
    <div class="wrap">
      <div class="sec-head">
        <p class="kick">{T('About an hour, on top of your own study', 'आपकी अपनी पढ़ाई के ऊपर, लगभग एक घंटा')}</p>
        <h2>{T('Your day on Aspiran', 'Aspiran के साथ आपका दिन')}</h2>
      </div>
      <ol class="day">
        {day.map(([when, h, p], i) => (
          <li>
            <span class="when">{when}</span>
            <div class="card">
              <h3>{h}</h3><p class="mute">{p}</p>
              {i === 0 && todayCard && (
                <a class="mini" href={dayUrl(today!.day, lang)}>
                  <span class="small">{T('Today\'s first card', 'आज का पहला कार्ड')} · {longDate(today!.day, lang)}</span>
                  <b>{todayCard.headline}</b>
                  <span class="more">{T('Read it free', 'मुफ़्त पढ़िए')} →</span>
                </a>
              )}
              {i === 1 && (
                <div class="mini">
                  <span class="small">{T('A revision question · GS2 · Preamble', 'रिवीज़न सवाल · GS2 · प्रस्तावना')}</span>
                  <b>{T('How many times has the Preamble been amended?', 'प्रस्तावना में कितनी बार संशोधन हुआ है?')}</b>
                  <span class="sure">{T('How sure are you?', 'कितने पक्के हैं?')} <i>{T('Guessing', 'अंदाज़ा')}</i><i>{T('Fairly', 'काफ़ी')}</i><i class="on">{T('Certain', 'पूरा')}</i></span>
                </div>
              )}
              {i === 2 && (
                <a class="mini" href="#answer">
                  <span class="small">{T('Back in minutes', 'मिनटों में वापस')}</span>
                  <b>{T('5 parts marked · 5 fixes · rewrite the weakest', '5 हिस्सों पर अंक · 5 सुधार · सबसे कमज़ोर दोबारा')}</b>
                  <span class="more">{T('See a checked answer', 'जँचा हुआ उत्तर देखिए')} ↓</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Everything inside -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <h2>{T('Everything for the full exam, in one app', 'पूरी परीक्षा के लिए सब कुछ, एक ऐप में')}</h2>
        <p>{T('From your first NCERT to the interview board.', 'पहली NCERT से इंटरव्यू बोर्ड तक।')}</p>
      </div>
      <div class="grid inside">{inside.map(([h, p], i) => <div class="card"><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{h}</h3><p class="mute">{p}</p></div>)}</div>
      <div class="ctas"><a class="btn primary" href={app('inside')} data-cta="try" data-where="inside">{T('Try a free topic, no sign-up', 'एक टॉपिक मुफ़्त आज़माइए, साइन-अप नहीं')}</a>
        <a class="btn ghost" href={`${P}/how-it-works/`}>{T('How Aspiran teaches', 'Aspiran कैसे पढ़ाता है')}</a></div>
    </div>
  </section>

  <!-- 6. A real checked answer -->
  <section class="sec tint" id="answer">
    <div class="wrap">
      <div class="sec-head">
        <p class="kick">{T('Sample · an answer we wrote, checked the way yours will be', 'नमूना · हमारा लिखा उत्तर, वैसे ही जँचा जैसे आपका जँचेगा')}</p>
        <h2>{T('This is what you get back, in minutes', 'यह मिलता है, मिनटों में')}</h2>
      </div>
      <div class="grid two ans">
        <div class="card">
          <p class="small">{sample.src}</p>
          <p style="font-size:19px"><b>{sample.q}</b></p>
          <details class="reveal"><summary>{T('Read the answer (126 words)', 'उत्तर पढ़िए (126 शब्द)')}</summary><p class="mute">{sample.answer}</p></details>
          <p class="verdict">{sample.verdict}</p>
        </div>
        <ol class="areas">
          {sample.areas.map(([a, note, fix]) => (
            <li class="card"><p class="area"><b>{a}</b><span class="band">{T('At the level', 'बराबर')}</span></p>
              <p class="mute">{note}</p><p class="fix"><b>{T('Fix: ', 'सुधार: ')}</b>{fix}</p></li>
          ))}
        </ol>
      </div>
      <p class="mute" style="margin-top:18px">{T('Then you rewrite the weakest part, and the rewrite is checked too. Free: 3 answers a week. Plus: as many as you write.',
        'फिर आप सबसे कमज़ोर हिस्सा दोबारा लिखते हैं, और वह भी जँचता है। मुफ़्त: हफ़्ते में 3 उत्तर। Plus: जितने आप लिखें।')}</p>
    </div>
  </section>

  <!-- 7. Free to read now: the proof, and the SEO hub -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="kick">{T('Free · no sign-up', 'मुफ़्त · साइन-अप नहीं')}</p>
        <h2>{T('Judge us by the material. Start reading now.', 'सामग्री से परखिए। अभी पढ़ना शुरू कीजिए।')}</h2>
        <p>{T('The same notes, current affairs and answer frames that are in the app, free on this website.', 'वही नोट्स, करेंट अफ़ेयर्स और उत्तर ढाँचे जो ऐप में हैं, इस वेबसाइट पर मुफ़्त।')}</p>
      </div>
      <div class="grid">
        <div class="card">
          <h3><a href={sectionUrl('current-affairs', lang)}>{T('Daily current affairs', 'रोज़ के करेंट अफ़ेयर्स')}</a></h3>
          <ul class="links">{caDays(lang).slice(0, 4).map((d) => <li><a href={dayUrl(d.day, lang)}>{longDate(d.day, lang)}</a><span class="small">{cardIn(d.cards[0], lang).headline}</span></li>)}</ul>
        </div>
        <div class="card">
          <h3><a href={sectionUrl('notes', lang)}>{T(`Notes (${pagesIn('notes', lang).length})`, `नोट्स (${pagesIn('notes', lang).length})`)}</a></h3>
          <ul class="links">{popular.map((p) => <li><a href={pageUrl(p, lang)}>{p.title[lang]}</a></li>)}</ul>
        </div>
        <div class="card">
          <h3><a href={sectionUrl('mains-answer-writing', lang)}>{T(`Mains answer frames (${pagesIn('mains-answer-writing', lang).length})`, `मेन्स उत्तर ढाँचे (${pagesIn('mains-answer-writing', lang).length})`)}</a></h3>
          <ul class="links">{frames.map((p) => <li><a href={pageUrl(p, lang)}>{p.title[lang]}</a></li>)}</ul>
        </div>
      </div>
      <ul class="chips">
        <li><a href="https://app.aspiran.in/learn/papers">{T('PYQs 2016–2026', 'PYQ 2016–2026')}</a></li>
        <li><a href={sectionUrl('ethics-case-studies', lang)}>{T('Ethics case studies', 'एथिक्स केस स्टडी')}</a></li>
        <li><a href={sectionUrl('essay-topics', lang)}>{T('Essay topics', 'निबंध विषय')}</a></li>
        <li><a href={sectionUrl('landmark-judgments', lang)}>{T('Landmark judgments', 'ऐतिहासिक फ़ैसले')}</a></li>
        <li><a href={sectionUrl('government-schemes', lang)}>{T('Government schemes', 'सरकारी योजनाएँ')}</a></li>
        <li><a href={sectionUrl('glossary', 'en')}>{T('English–Hindi glossary', 'अंग्रेज़ी–हिंदी शब्दावली')}</a></li>
        <li><a href="https://app.aspiran.in/learn">{T('Syllabus, topic by topic', 'सिलेबस, टॉपिक दर टॉपिक')}</a></li>
      </ul>
    </div>
  </section>

  <!-- 8. Remember the fact? A 20-second proof of the method -->
  <section class="sec night">
    <div class="wrap grid two" style="align-items:center">
      <div>
        <p class="kick" style="color:#E9B13A">{T('A 20-second experiment', '20 सेकंड का प्रयोग')}</p>
        <h2>{T('Read this once. Then answer without looking.', 'इसे एक बार पढ़िए। फिर बिना देखे जवाब दीजिए।')}</h2>
        <p class="mute" id="recall-fact">{hi ? <>प्रस्तावना में ठीक <b>एक बार</b> संशोधन हुआ है: 1976 में, 42वें संशोधन से, जिसने <b>समाजवादी, पंथनिरपेक्ष</b> और <b>अखंडता</b> जोड़े।</>
          : <>The Preamble has been amended exactly <b>once</b>: in 1976, by the 42nd Amendment, which added <b>socialist, secular</b> and <b>integrity</b>.</>}</p>
      </div>
      <div class="card recall" style="background:#1F2130;border-color:#2F3242">
        <button type="button" class="btn primary" id="recall-go">{T('I\'ve read it. Ask me.', 'पढ़ लिया। पूछिए।')}</button>
        <div id="recall-q" hidden>
        <p><b style="color:#F3ECE0">{T('In which year was the Preamble amended?', 'प्रस्तावना में संशोधन किस वर्ष हुआ?')}</b></p>
        <div class="opts-grid" id="recall-opts" data-right="1976" data-yes={T('Right. 1976, the 42nd Amendment.', 'सही। 1976, 42वाँ संशोधन।')} data-no={T('It was 1976, the 42nd Amendment.', 'यह 1976 था, 42वाँ संशोधन।')}>
          {['1971', '1976', '1978', T('No idea', 'पता नहीं')].map((o) => <button type="button" data-v={o}>{o}</button>)}
        </div>
        </div>
        <p class="out" id="recall-out" aria-live="polite" style="color:#F3ECE0"></p>
        <p id="recall-after" hidden style="color:#A9A397">{T('Pulling it out of memory, even when it\'s hard, is what makes it stay. Reading it again feels easier and does less. Aspiran does this with everything you study, and asks again just before you would forget.',
          'याद से निकालना, मुश्किल हो तब भी, यही उसे टिकाता है। दोबारा पढ़ना आसान लगता है, पर कम काम करता है। Aspiran आपकी हर पढ़ाई के साथ यही करता है, और ठीक भूलने से पहले फिर पूछता है।')}</p>
      </div>
    </div>
  </section>

  <!-- 9. Where it fits -->
  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><h2>{T('It doesn\'t replace your coaching. It makes it count.', 'यह आपकी कोचिंग की जगह नहीं लेता। उसे काम का बनाता है।')}</h2></div>
      <div class="table" role="table" aria-label={T('Aspiran next to coaching and YouTube', 'कोचिंग और YouTube के साथ Aspiran')}>
        <div class="tr head" role="row"><span role="columnheader"></span>{fit.cols.map((c, i) => <span role="columnheader" class={i === 2 ? 'us' : ''}>{c}</span>)}</div>
        {fit.rows.map(([k, a, b, c]) => (
