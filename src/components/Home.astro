// A PYQ to answer right here: recent, with UPSC's key and an explanation (and Hindi on the Hindi page).
const pick = (() => {
  for (const p of PAPERS) {
    if (p.exam !== 'prelims' || p.key.status !== 'official') continue;
    const q = p.questions.find((x) => x.explain && typeof x.answer === 'number' && (x.en.options?.length ?? 0) === 4 && x.en.q.length < 380 && (!hi || x.hi?.q));
    if (q) return { p, q };
  }
  return null;
})();

