    .inside .num { font: 800 15px var(--serif); color: var(--chai); display: block; margin-bottom: 6px; }

    .ans .verdict { border-left: 4px solid var(--leaf); padding-left: 12px; font-weight: 600; margin-top: 16px; }
    .areas { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
    .areas .card { padding: 16px 18px; }
    .area { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 4px; }
    .band { font: 700 13px/1 var(--sans); background: var(--leaf-soft); color: var(--leaf); border-radius: 999px; padding: 6px 10px; white-space: nowrap; align-self: flex-start; }
    .fix { margin: 0; font-size: 16px; }

    .links { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 10px; }
    .links li { display: flex; flex-direction: column; }
    .links a { font-weight: 600; }
    .links .small { line-height: 1.35; }
    .card h3 a { color: var(--ink); text-decoration: none; }
    .card h3 a:hover { color: var(--chai-2); text-decoration: underline; }
    .chips { list-style: none; padding: 0; margin: 22px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
    .chips a { display: inline-block; border: 1.5px solid var(--line-2); border-radius: 999px; padding: 8px 14px; color: var(--ink); text-decoration: none; font-weight: 600; font-size: 16px; background: var(--card); }
    .chips a:hover { border-color: var(--chai); color: var(--chai-2); }

    #recall-go[hidden] { display: none; }
    #recall-fact.gone { filter: blur(7px); user-select: none; }
    .opts-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 14px 0 6px; }
    .opts-grid button { font: 700 17px var(--sans); color: #F3ECE0; background: transparent; border: 1.5px solid #3A3C48; border-radius: 12px; padding: 12px; min-height: 50px; cursor: pointer; }
    .opts-grid button:hover:not(:disabled) { border-color: #E9B13A; }
    .opts-grid button.right { border-color: #7CC79B; background: rgba(124, 199, 155, .16); }
    .opts-grid button.wrong { border-color: #F08A7B; background: rgba(240, 138, 123, .14); }

    .table { border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; background: var(--card); }
    .tr { display: grid; grid-template-columns: 1.1fr 1fr 1fr 1fr; border-top: 1px solid var(--line); }
    .tr:first-child { border-top: 0; }
    .tr > span { padding: 14px 16px; font-size: 16px; }
    .tr.head > span { font-weight: 700; background: var(--paper-2); }
    .tr [role="rowheader"] { font-weight: 700; }
    .tr .us { background: color-mix(in srgb, var(--haldi) 14%, var(--card)); font-weight: 600; }
    @media (max-width: 760px) {
      .tr.head { display: none; }
      .tr { grid-template-columns: 1fr; padding: 8px 0; }
      .tr > span { padding: 4px 16px; }
      .tr > span[data-h]::before { content: attr(data-h) ": "; color: var(--ink-3); font-weight: 500; }
    }

    .never { list-style: none; padding: 0; margin: 8px 0 0; }
    .never li { padding: 7px 0 7px 28px; position: relative; color: var(--ink-2); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--wrong) 60%, transparent); }
    .never li::before { content: "✕"; position: absolute; left: 4px; color: var(--wrong); }

    .price .card { display: flex; flex-direction: column; }
    .price .card.main { border: 2px solid var(--chai); }
    .price .amount { font: 800 44px/1.1 var(--serif); margin: 0 0 4px; }
    .price .amount span { font: 500 18px var(--sans); color: var(--ink-2); }
    .price ul { padding-left: 20px; margin: 10px 0 20px; }
    .price li { margin: 6px 0; }
    .price .btn { align-self: flex-start; margin-top: auto; }

    .coach { background: var(--night); border-color: var(--night); color: var(--night-ink) !important; }
    .coach h2 { color: var(--night-ink); font-size: clamp(24px, 3vw, 32px); }
    .coach .mute { color: var(--night-2); }
    .coach .more { color: #E9B13A; }
    .coach .kick { color: #E9B13A; }

    .later { max-width: 560px; margin: 30px auto 0; text-align: left; }
    .later label { display: block; margin-bottom: 8px; color: var(--ink-2); }
  </style>

  <script>
    const HI = document.documentElement.lang === 'hi';
    const ph = (name: string, props: Record<string, unknown> = {}) => (window as any).posthog?.capture?.(name, props);

    // The hero phone: three demo screens, one every 4 seconds, once through. No motion with reduced motion; tap for next.
    const frame = document.querySelector('.phone-frame');
    if (frame) {
      const imgs = [...frame.querySelectorAll('img')];
      const cap = document.getElementById('phone-cap')!;
      let i = 0;
      const show = (n: number) => { i = n; imgs.forEach((im, k) => im.classList.toggle('on', k === n)); cap.textContent = imgs[n].alt; };
      frame.addEventListener('click', () => show((i + 1) % imgs.length));
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const t = setInterval(() => { if (i >= imgs.length - 1) return clearInterval(t); show(i + 1); }, 4000);
      }
    }

    // The recall question: the fact hides first, so it really is from memory.
    document.getElementById('recall-go')?.addEventListener('click', (e) => {
      (e.currentTarget as HTMLElement).hidden = true;
      document.getElementById('recall-fact')!.classList.add('gone');
      document.getElementById('recall-q')!.hidden = false;
    });
    const opts = document.getElementById('recall-opts')!;
    opts.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b || opts.dataset.done) return;
      opts.dataset.done = '1';
      const right = b.dataset.v === opts.dataset.right;
      opts.querySelectorAll('button').forEach((x) => { x.disabled = true; if (x.dataset.v === opts.dataset.right) x.classList.add('right'); });
      if (!right) b.classList.add('wrong');
      document.getElementById('recall-out')!.textContent = right ? opts.dataset.yes! : opts.dataset.no!;
      document.getElementById('recall-after')!.hidden = false;
      ph('recall_answered', { right });
    });

    // "Send me the link": /web/lead on the app server emails the link at once.
    const store = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private window */ } } };
    const visitorId = store.get('aspiran-vid') ?? `v-${crypto.getRandomValues(new Uint32Array(3)).join('-')}`;
    store.set('aspiran-vid', visitorId);
    const API = /^(localhost|127\.0\.0\.1)$/.test(location.hostname) ? 'http://localhost:8788' : 'https://app.aspiran.in';
    const u = new URL(location.href);
    const source = ['utm_source', 'utm_medium', 'utm_campaign'].map((k) => u.searchParams.get(k)).filter(Boolean).join('/') || (document.referrer ? new URL(document.referrer).hostname : 'direct');
    document.getElementById('later')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.currentTarget as HTMLFormElement;
      const out = document.getElementById('later-out')!;
      const contact = (document.getElementById('later-in') as HTMLInputElement).value.trim();
      if (!/^\S+@\S+\.\S+$/.test(contact)) { out.textContent = HI ? 'ईमेल पता डालिए।' : 'Add an email address.'; return; }
      out.textContent = HI ? 'भेज रहे हैं…' : 'Sending…';
      try {
        const r = await fetch(`${API}/web/lead`, { method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ visitorId, details: {}, contact, consent: true, lang: HI ? 'hi' : 'en', source, company: (f.elements.namedItem('company') as HTMLInputElement).value }) });
        if (!r.ok) throw new Error();
        out.textContent = HI ? 'भेज दिया। अपना इनबॉक्स देखिए।' : 'Sent. Check your inbox.';
        ph('lead_saved', { kind: 'email' });
      } catch { out.textContent = HI ? 'अभी नहीं भेज पाए। ऊपर का बटन सीधे ऐप खोलता है।' : "Couldn't send just now. The button above opens the app directly."; }
    });
  </script>
