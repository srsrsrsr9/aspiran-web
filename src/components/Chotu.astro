---
// Chotu, the clay chai cup. Always carries the AI badge. Gestures are driven by
// src/scripts/site.ts: it swaps the .ch-gest class (gst0..gst6) on every [data-chotu="<group>"].
interface Props {
  group: string;
  size?: number;
  label?: string;
}
const { group, size = 150, label = 'Chotu, an AI chai cup' } = Astro.props;
---

<svg
  class="chotu"
  data-chotu={group}
  viewBox="0 0 200 230"
  width={size}
  role="img"
  aria-label={label}
>
  <ellipse cx="100" cy="216" rx="58" ry="8" fill="#2A1B12" opacity=".2"></ellipse>
  <g class="ch-idle">
    <g class="ch-gest gst0">
      <g class="ch-steam" fill="none" stroke="var(--saffron)" stroke-width="5" stroke-linecap="round">
        <path d="M80 52c-8-10 8-14 0-26"></path>
        <path d="M100 48c-8-10 8-14 0-28"></path>
        <path d="M120 52c-8-10 8-14 0-26"></path>
      </g>
      <ellipse class="ch-armL" cx="36" cy="132" rx="17" ry="9" fill="#9A4A26"></ellipse>
      <ellipse class="ch-armR" cx="164" cy="132" rx="17" ry="9" fill="#9A4A26"></ellipse>
      <path d="M38 74H162L148 192Q146 208 130 208H70Q54 208 52 192Z" fill="#C8693A"></path>
      <path d="M45 150H155L148 192Q146 208 130 208H70Q54 208 52 192Z" fill="#9A4A26" opacity=".35"></path>
      <ellipse cx="100" cy="74" rx="64" ry="12" fill="#E08A55"></ellipse>
      <ellipse cx="100" cy="74" rx="54" ry="7.5" fill="#6B3A1F"></ellipse>
      <ellipse class="ch-eye" cx="76" cy="120" rx="8" ry="11" fill="#2A1B12"></ellipse>
      <circle cx="79" cy="115" r="3" fill="#fff"></circle>
      <ellipse class="ch-eye" cx="124" cy="120" rx="8" ry="11" fill="#2A1B12"></ellipse>
      <circle cx="127" cy="115" r="3" fill="#fff"></circle>
      <ellipse cx="58" cy="142" rx="9" ry="6" fill="#F2A27C" opacity=".75"></ellipse>
      <ellipse cx="142" cy="142" rx="9" ry="6" fill="#F2A27C" opacity=".75"></ellipse>
      <path d="M88 140Q100 154 112 140" fill="none" stroke="#2A1B12" stroke-width="4" stroke-linecap="round"></path>
      <rect x="82" y="168" width="36" height="20" rx="6" fill="#FFF6EA"></rect>
      <text x="100" y="183" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" font-weight="700" fill="#6B3A1F">AI</text>
    </g>
  </g>
</svg>
