---
// "Watch on this topic": up to 4 shorts on the same syllabus lines as the page, linking to their /binge/ pages.
// Renders nothing when no short matches.
import ShortTile from './ShortTile.astro';
import type { Lang } from '../lib/content';
import { shortsFor, bingeHome } from '../lib/shorts';
interface Props { nodes: string[]; lang: Lang; n?: number }
const { nodes, lang, n = 4 } = Astro.props;
const hi = lang === 'hi';
const list = shortsFor(nodes, lang, n);
---
{list.length > 0 && (
  <aside class="watch-strip" data-say={hi ? 'पढ़कर थक गए? इसी विषय पर दो मिनट का वीडियो देखिए।' : 'Tired of reading? Here is the same part of the syllabus in two minutes.'}>
    <h2>▶ {hi ? 'इसी विषय पर, दो मिनट में' : 'On this topic, in two minutes'}</h2>
    <p class="small mute" style="margin:0 0 10px">{hi ? 'छोटे चित्र-वीडियो, आवाज़ तभी जब आप चालू करें।' : 'Short illustrated videos. Sound only when you turn it on.'} <a href={bingeHome(lang)}>{hi ? 'सारे देखिए' : 'See them all'} →</a></p>
    <div class="shelf-row">{list.map((s) => <ShortTile s={s} lang={lang} />)}</div>
  </aside>
)}
