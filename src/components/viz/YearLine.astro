---
// Every page in a section on one line of years (judgments by decision year, schemes by launch), this one lit. Each dot
// is a link: coverage you can see, and a way to wander.
import type { Lang } from '../../lib/content';
interface Props { lang: Lang; items: { year: number; href: string; title: string; me?: boolean }[]; label: string }
const { items, label } = Astro.props;
const ys = items.map((i) => i.year).filter(Boolean);
const lo = Math.floor(Math.min(...ys) / 10) * 10, hiY = Math.ceil((Math.max(...ys) + 1) / 10) * 10;
const W = 640, X0 = 16, X1 = W - 16;
const x = (y: number) => X0 + ((y - lo) / (hiY - lo)) * (X1 - X0);
const seen = new Map<number, number>();
const dots = items.filter((i) => i.year).sort((a, b) => a.year - b.year).map((i) => { const k = seen.get(i.year) ?? 0; seen.set(i.year, k + 1); return { ...i, k }; });
const me = dots.find((d) => d.me);
const decades: number[] = []; for (let d = lo; d <= hiY; d += 10) decades.push(d);
---
<figure class="yearline">
  <p class="kick">{label}</p>
  <svg viewBox={`0 0 ${W} 96`} role="img" aria-label={label}>
    <path d={`M${X0} 58H${X1}`} stroke="var(--line-2)" stroke-width="2" />
    {decades.map((d) => <g><path d={`M${x(d)} 52v12`} stroke="var(--line-2)" stroke-width="1.5" /><text x={x(d)} y="84" text-anchor="middle" font-size="13" fill="var(--ink-3)">{d}</text></g>)}
    {dots.map((d) => <a href={d.href}><title>{`${d.title} (${d.year})`}</title><circle cx={x(d.year)} cy={58 - d.k * 13} r={d.me ? 9 : 5.5} fill={d.me ? 'var(--chai)' : 'var(--card)'} stroke={d.me ? 'var(--ink)' : 'var(--chai)'} stroke-width="2" /></a>)}
    {me && <text x={Math.min(X1 - 20, Math.max(X0 + 20, x(me.year)))} y={58 - me.k * 13 - 16} text-anchor="middle" font-size="15" font-weight="800" fill="var(--ink)">{me.year}</text>}
  </svg>
</figure>
