---
// How often UPSC has asked on this page's syllabus: stacked bars per year (Mains on this exact syllabus line, Prelims
// on its subject), and links to the latest of those PYQs on this site. Trust through depth.
import { pyqPulse, YEARS } from '../../lib/visual';
import { type Lang, qUrl, paperName, nodeName } from '../../lib/content';
interface Props { nodes: string[]; lang: Lang; about?: string; skip?: string }
const { nodes, lang, about = '', skip } = Astro.props;
const hi = lang === 'hi';
const { mains, pre, mHits, pHits, preNode, total } = pyqPulse(nodes);
const max = Math.max(1, ...YEARS.map((y) => (mains.get(y) ?? 0) + (pre.get(y) ?? 0)));
const ok = (x: (typeof mHits)[number]) => (!hi || x.q.hi?.q) && `${x.paper.id}-${x.q.n}` !== skip;
// The examples shown: the PYQs sharing the most words with this page, newest first among equals.
const STOP = new Set(['which', 'following', 'statements', 'statement', 'correct', 'given', 'about', 'consider', 'select', 'answer', 'below', 'using', 'there', 'their', 'these', 'those', 'other', 'discuss', 'examine', 'explain', 'india', 'indian', 'words', 'marks', 'their', 'under', 'between', 'what', 'where', 'while', 'should']);
const words = new Set((about.toLowerCase().match(/[a-z]{5,}/g) ?? []).filter((w) => !STOP.has(w)));
const score = (x: (typeof mHits)[number]) => (x.q.en.q.toLowerCase().match(/[a-z]{5,}/g) ?? []).filter((w) => words.has(w)).length;
const newest = (a: typeof mHits) => a.filter(ok).map((x) => ({ x, s: score(x) })).sort((p, q) => q.s - p.s || q.x.paper.year - p.x.paper.year).map((o) => o.x);
const latest = [...newest(mHits).slice(0, 2), ...newest(pHits).slice(0, mHits.length ? 1 : 3)];
const W = 560, H = 150, bw = W / YEARS.length;
const subject = preNode ? nodeName(preNode)?.name : '';
const qText = (x: (typeof mHits)[number]) => { const s = ((hi && x.q.hi?.q) || x.q.en.q).replace(/\s+/g, ' '); return s.length > 120 ? s.slice(0, 118).replace(/\s\S*$/, '') + '…' : s; };
---
{total > 0 && (
  <section class="pulse" data-say={hi ? `UPSC इस हिस्से से ${total} सवाल पूछ चुका है। ऐप में हर PYQ इसी टॉपिक के साथ जुड़ा है, आंसर-की समेत।` : `UPSC has asked ${total} questions from here. In the app, every one sits right under this topic, with the key.`}>
    <div class="pulse-head">
      <p class="pulse-big">{total}</p>
      <p><b>{hi ? `PYQ, ${YEARS[0]} से अब तक` : `PYQs on this, ${YEARS[0]} to ${YEARS[YEARS.length - 1]}`}</b><br />
        <span class="pulse-key">
          {mHits.length > 0 && <span><i class="k-m"></i>{hi ? `मेन्स, इसी सिलेबस लाइन से: ${mHits.length}` : `Mains, this syllabus line: ${mHits.length}`}</span>}
          {pHits.length > 0 && <span><i class="k-p"></i>{hi ? `प्रीलिम्स, इसी विषय से: ${pHits.length}` : `Prelims, ${subject || 'this subject'}: ${pHits.length}`}</span>}
        </span></p>
    </div>
    <svg viewBox={`0 0 ${W} ${H + 24}`} class="pulse-bars" role="img" aria-label={(hi ? 'साल दर साल PYQ: ' : 'PYQs by year: ') + YEARS.map((y) => `${y}: ${(mains.get(y) ?? 0) + (pre.get(y) ?? 0)}`).join(', ')}>
      {YEARS.map((y, i) => {
        const m = mains.get(y) ?? 0, p = pre.get(y) ?? 0, v = m + p;
        const hp = p ? Math.max(4, (p / max) * (H - 22)) : 0, hm = m ? Math.max(4, (m / max) * (H - 22)) : 0;
        return (<g>
          {!v && <rect x={i * bw + bw * 0.18} y={H - 3} width={bw * 0.64} height="3" rx="1.5" fill="var(--line)" />}
          {p > 0 && <rect x={i * bw + bw * 0.18} y={H - hp} width={bw * 0.64} height={hp} rx="4" fill="var(--haldi)" />}
          {m > 0 && <rect x={i * bw + bw * 0.18} y={H - hp - hm} width={bw * 0.64} height={hm} rx="4" fill="var(--chai)" />}
          {v > 0 && <text x={i * bw + bw / 2} y={H - hp - hm - 6} text-anchor="middle" font-size="13" font-weight="700" fill="var(--ink-2)">{v}</text>}
          <text x={i * bw + bw / 2} y={H + 18} text-anchor="middle" font-size="12.5" fill="var(--ink-3)">{`'${String(y).slice(2)}`}</text>
        </g>);
      })}
    </svg>
    {latest.length > 0 && <ul class="pulse-list">{latest.map((x) => <li><a href={qUrl(x.paper, x.q, lang)}><span class="tag">{paperName(x.paper, lang)} · Q{x.q.n}</span>{qText(x)}</a></li>)}</ul>}
  </section>
)}
