---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chotu from '../components/Chotu.astro';
import { waUrl, WA_MSG_EN, WA_MSG_HI } from '../i18n';
import '@fontsource/martel/latin-800.css';
import '@fontsource/martel/devanagari-700.css';
import '@fontsource/mukta/devanagari-400.css';
import '../styles/chotu.css';
import '../styles/home.css';

// The long home page, in English (/) and Hindi (/hi/). Copy is in this file, room by room, the two languages side
// by side; Chotu's lines and questions are in
// src/scripts/home.ts. Everything works without the server; Chotu's free-text replies and saving a visitor's
// details need the Worker's /web/chotu and /web/lead routes (server/src/web.ts in the app repo).

interface Props { lang?: 'en' | 'hi' }
const { lang = 'en' } = Astro.props;
const hi = lang === 'hi';

const title = hi ? 'Aspiran: UPSC का सिलेबस रोशन कीजिए' : 'Aspiran: light up the UPSC syllabus';
const description = hi
  ? 'UPSC की पढ़ाई की ऐसी जगह, जहाँ अक्टूबर में पढ़ा मार्च में भी याद रहे। छोटे पॉड, रोज़ का रिव्यू जो ख़त्म होता है, मेन्स के उत्तर जिन्हें आप दोबारा लिखते हैं, और चोटू, AI चाय का कप जो साथ चलता है। न स्ट्रीक, न लीडरबोर्ड, न रैंक की भविष्यवाणी।'
  : 'A UPSC study space where what you read in October is still there in March. Small pods, a daily review that ends, Mains answers you rewrite, and Chotu, an AI chai cup that walks with you. No streaks, no leaderboards, no rank predictions.';

// The syllabus sky: [paper, topic]. Positions are generated in the script, clustered by paper.
const sky: [string, string][] = [
  ['GS1', 'Ancient India'], ['GS1', 'Medieval India'], ['GS1', 'Modern India'], ['GS1', 'Freedom struggle'], ['GS1', 'Art and culture'],
  ['GS1', 'World history'], ['GS1', 'Society'], ['GS1', 'Urbanisation'], ['GS1', 'Physical geography'], ['GS1', 'Indian geography'],
  ['GS1', 'Monsoon'], ['GS1', 'Resources'], ['GS2', 'Constitution'], ['GS2', 'Preamble'], ['GS2', 'Fundamental rights'],
  ['GS2', 'Parliament'], ['GS2', 'Judiciary'], ['GS2', 'Federalism'], ['GS2', 'Finance Commission'], ['GS2', 'Local bodies'],
  ['GS2', 'Governance'], ['GS2', 'Welfare schemes'], ['GS2', 'India and neighbours'], ['GS2', 'Global groupings'],
  ['GS3', 'Growth and inflation'], ['GS3', 'Budget'], ['GS3', 'Banking'], ['GS3', 'Agriculture'], ['GS3', 'Infrastructure'],
  ['GS3', 'Science and tech'], ['GS3', 'Space'], ['GS3', 'Environment'], ['GS3', 'Climate change'], ['GS3', 'Disasters'],
  ['GS3', 'Internal security'], ['GS3', 'Cyber security'], ['GS4', 'Ethics basics'], ['GS4', 'Attitude'], ['GS4', 'Emotional intelligence'],
  ['GS4', 'Integrity'], ['GS4', 'Case studies'], ['GS4', 'Probity'], ['Essay', 'Thesis'], ['Essay', 'Structure'],
  ['Essay', 'Openings'], ['Essay', 'Examples'], ['CSAT', 'Comprehension'], ['CSAT', 'Reasoning'], ['CSAT', 'Numeracy'],
  ['CSAT', 'Data'], ['Optional', 'Paper 1'], ['Optional', 'Paper 2'], ['Optional', 'PYQ themes'], ['Optional', 'Answers'],
];
// The same stars, named in Hindi for /hi/ (same order).
const skyHi = ["प्राचीन भारत", "मध्यकालीन भारत", "आधुनिक भारत", "स्वतंत्रता संग्राम", "कला और संस्कृति", "विश्व इतिहास", "समाज", "शहरीकरण", "भौतिक भूगोल", "भारत का भूगोल", "मानसून", "संसाधन", "संविधान", "उद्देशिका", "मौलिक अधिकार", "संसद", "न्यायपालिका", "संघवाद", "वित्त आयोग", "स्थानीय निकाय", "शासन", "कल्याणकारी योजनाएँ", "भारत और पड़ोसी", "वैश्विक समूह", "विकास और महँगाई", "बजट", "बैंकिंग", "कृषि", "बुनियादी ढाँचा", "विज्ञान और तकनीक", "अंतरिक्ष", "पर्यावरण", "जलवायु परिवर्तन", "आपदाएँ", "आंतरिक सुरक्षा", "साइबर सुरक्षा", "नीतिशास्त्र की बुनियाद", "अभिवृत्ति", "भावनात्मक बुद्धि", "सत्यनिष्ठा", "केस स्टडी", "शुचिता", "मुख्य तर्क", "ढाँचा", "शुरुआत", "उदाहरण", "बोधगम्यता", "तर्कशक्ति", "संख्यात्मकता", "आँकड़े", "प्रश्नपत्र 1", "प्रश्नपत्र 2", "PYQ के विषय", "उत्तर"];


const passage = hi ? [
  'हर गर्मी में, शहर की सबसे गर्म गलियाँ शायद ही कभी सबसे अमीर होती हैं।',
  'पेड़, छाँव और ठंडी छतें पैसे के पीछे चलती हैं, क्योंकि वे ज़मीन की क़ीमत के पीछे चलती हैं।',
  'योजनाकार अक्सर गर्मी को मौसम मानते हैं, जो सब पर बराबर पड़ता है।',
  'पर छाँव किसे मिलेगी, यह किसी लू से बरसों पहले बजट बैठकों में तय होता है।',
  'जो हीट योजना इसे नज़रअंदाज़ करे, वह पहले से सुरक्षित लोगों को ही बचाती रहेगी।',
  'शहर ग़रीबों को संयोग से नहीं छोड़ते; उनका नक़्शा ही ऐसा बनाया जाता है।',
] : [
  'Every summer, the hottest streets in a city are rarely the richest ones.',
  'Trees, shade and cool roofs follow money, because they follow land prices.',
  'Planners often treat heat as weather, something that simply happens to everyone.',
  'Yet who gets shade is decided in budget meetings, years before any heatwave.',
  'A heat plan that ignores this will keep protecting the already protected.',
  'Cities do not fail the poor by accident; they are drawn that way.',
];

const never = hi ? [
  'स्ट्रीक, जिसके टूटने का डर लगे',
  'लीडरबोर्ड और सबके सामने रैंक',
  '"आपके चयन की संभावना: 73%"',
  '"सिर्फ़ 4 सीटें बचीं" वाली उलटी गिनती',
  '14 घंटे वाली टॉपर रूटीन रील',
  'पीछा करती नोटिफ़िकेशन',
  'आपका नंबर किसी कॉल सेंटर को बेचना',
  '300 पन्नों की मासिक पत्रिका',
] : [
  'Streaks you are scared to break',
  'Leaderboards and public ranks',
  '"Your selection chance: 73%"',
  '"Only 4 seats left" countdowns',
  '14-hour topper routine reels',
  'Notifications that chase you',
  'Your number sold to a call centre',
  'A 300-page monthly magazine',
];

const WA = waUrl(hi ? WA_MSG_HI : WA_MSG_EN);
---

<BaseLayout title={title} description={description} themeColor="#06070F" lang={lang}>
  <div class="night" id="top">
    <a class="skip" href="#main">{hi ? 'पेज पर जाएँ' : 'Skip to the page'}</a>
    <canvas id="stars" aria-hidden="true"></canvas>

    <nav class="hud-nav" aria-label="Site">
      <a class="brand" href="#top">
        <svg aria-hidden="true" width="30" height="30" viewBox="0 0 40 40">
          <path d="M14 3c-2 3 2 4 0 7M20 2c-2 3 2 4 0 8M26 3c-2 3 2 4 0 7" fill="none" stroke="#F0A04B" stroke-width="2" stroke-linecap="round"></path>
          <path d="M5 15h30l-4.5 20.5a3 3 0 0 1-3 2.5H12.5a3 3 0 0 1-3-2.5z" fill="#C8693A"></path>
          <rect x="4" y="13" width="32" height="4.5" rx="2.2" fill="#E08A55"></rect>
        </svg>
        <b>Aspiran</b>
      </a>
      <div class="hud-r">
        {hi ? <a class="lang-link" href="/" hreflang="en" lang="en">English</a> : <a class="lang-link" href="/hi/" hreflang="hi" lang="hi">हिंदी</a>}
        <span class="hud-tag" aria-hidden="true">● ONLINE</span>
        <a class="btn ghost sm" href="#seat" data-umami-event="cta-seat" data-umami-event-where="nav">{hi ? 'मेरी सीट रखें' : 'Save my seat'}</a>
      </div>
    </nav>

    <!-- 1. Hero -->
    <header class="hero" data-scene="hero">
      <p class="hud">{hi ? 'आपका UPSC अड्डा। चाय हमारी तरफ़ से।' : 'YOUR UPSC ADDA. CHAI\'S ON US.'}</p>
      <h1>{hi ? <>सिलेबस को<br /><span class="glow-text">रोशन कीजिए।</span></> : <>Light up<br /><span class="glow-text">the syllabus.</span></>}</h1>
      <p class="lede">{hi ? <>
        पढ़ाई की ऐसी जगह, जहाँ अक्टूबर में पढ़ा मार्च में भी याद रहे। जहाँ आपके उत्तर इसलिए बेहतर हों कि आपने उन्हें दोबारा
        लिखा, इसलिए नहीं कि टॉपर की कॉपी पढ़ी। जहाँ कोई आपके घंटे नहीं गिनता, और कोई आपको रैंक नहीं करता।
      </> : <>
        A study space where what you read in October is still there in March. Where your answers get better because you
        rewrote them, not because you read a topper's copy. Where nobody counts your hours, and nobody ranks you.
      </>}</p>
      <div class="ctas">
        <button class="btn primary" type="button" data-open-chotu data-umami-event="cta-chotu" data-umami-event-where="hero">{hi ? 'चोटू को नमस्ते कहिए' : 'Say hi to Chotu'}</button>
        <a class="btn ghost" href="#plant">{hi ? 'स्क्रॉल कीजिए। कुछ होगा।' : 'Scroll. Things happen.'}</a>
      </div>
      <p class="hud dim scroll-cue" aria-hidden="true">{hi ? '↓ नीचे 17 कमरे। हर एक छोटा है।' : '↓ 17 rooms below. Each one is short.'}</p>
    </header>

    <main id="main">
      <!-- 2. The planted fact -->
      <section class="scene plant" id="plant" data-scene="plant">
        <p class="hud">{hi ? 'कमरा 01 · एक छोटा प्रयोग' : 'ROOM 01 · A SMALL EXPERIMENT'}</p>
        <h2>{hi ? <>इसे याद रखिए।<br />बाद में पूछूँगा।</> : <>Remember this.<br />I'll ask you later.</>}</h2>
        <div class="fact-card" data-reveal>
          <span class="hud">{hi ? 'तथ्य · GS2 · उद्देशिका' : 'FACT · GS2 · PREAMBLE'}</span>
          <p>{hi ? <>उद्देशिका में <b>सिर्फ़ एक बार</b> संशोधन हुआ है: 1976 में, 42वें संशोधन से, जिसने
            <b>समाजवादी</b>, <b>पंथनिरपेक्ष</b> और <b>अखंडता</b> शब्द जोड़े।</> : <>The Preamble has been amended <b>exactly once</b>: in 1976, by the 42nd Amendment, which added
            <b>socialist</b>, <b>secular</b> and <b>integrity</b>.</>}</p>
        </div>
        <p class="note">{hi ? 'कोई दबाव नहीं। इसके लिए वापस स्क्रॉल मत कीजिए। क्यों, आगे दिखेगा।' : 'No pressure. Don\'t scroll back for it. You\'ll see why.'}</p>
      </section>

      <!-- 3. The leak -->
      <section class="scene leak" id="leak" data-scene="leak">
        <p class="hud">{hi ? 'कमरा 02 · रिसाव' : 'ROOM 02 · THE LEAK'}</p>
        <h2>{hi ? 'ज़्यादातर तैयारी रिसती है।' : 'Most prep leaks.'}</h2>
        <p class="lede">{hi ? <>आप एक अध्याय पढ़ते हैं। पक्का लगता है। दिवाली बीतते-बीतते उसका ज़्यादातर हिस्सा चुपचाप बह जाता है,
          और पता परीक्षा हॉल में चलता है।</> : <>You read a chapter. It feels solid. By the time Diwali's over, most of it has quietly drained away,
          and you only find out in the exam hall.</>}</p>
        <div class="leak-box" data-reveal>
          <div class="seg" role="group" aria-label={hi ? 'पढ़ने का तरीक़ा चुनिए' : 'Choose a way to study'}>
            <button type="button" data-leak="read" aria-pressed="true">{hi ? 'पढ़ो और आगे बढ़ो' : 'Read and move on'}</button>
            <button type="button" data-leak="aspiran" aria-pressed="false">{hi ? 'Aspiran का रोज़ का रिव्यू' : 'Aspiran\'s daily review'}</button>
          </div>
          <svg class="leak-chart" viewBox="0 0 600 240" role="img" aria-labelledby="leak-cap">
            <line x1="40" y1="200" x2="580" y2="200" class="axis"></line>
            <text x="40" y="226" class="tick">{hi ? 'अक्टू' : 'Oct'}</text><text x="170" y="226" class="tick">{hi ? 'दिस' : 'Dec'}</text>
            <text x="300" y="226" class="tick">{hi ? 'जन' : 'Jan'}</text><text x="430" y="226" class="tick">{hi ? 'फ़र' : 'Feb'}</text><text x="545" y="226" class="tick">{hi ? 'मार्च' : 'Mar'}</text>
            <text x="40" y="24" class="tick">{hi ? 'जो अब भी याद है' : 'What you can still recall'}</text>
            <path id="leak-path" class="curve" d=""></path>
            <g id="leak-dots"></g>
          </svg>
          <p class="cap" id="leak-cap">{hi ? <>रिव्यू के बिना यह बह जाता है। भूलने से ठीक पहले छोटे रिव्यू से हर गिरावट छोटी होती है,
            और रिव्यू के बीच का अंतर एक दिन से हफ़्ते और फिर महीनों तक बढ़ता है। <span class="dim">यह आकार का एक ख़ाका है, आपका डेटा नहीं।</span></> : <>Without review, it drains. With a short review just before you'd forget, each dip is smaller,
            and the gaps between reviews grow from a day to a week to months. <span class="dim">A sketch of the shape, not your data.</span></>}</p>
        </div>
        <p class="effect">{hi ? 'रोज़ दस से बीस मिनट। हर दिन ख़त्म होता है। कुछ भी जमा होकर अपराध-बोध नहीं बनता।' : 'Ten to twenty minutes a day. It ends every day. Nothing piles up into guilt.'}</p>
      </section>

      <aside class="pause" data-scene="q1" aria-label={hi ? 'एक ठहराव' : 'A pause'}>
        <blockquote>{hi ? <>"दोबारा पढ़ना सीखने जैसा लगता है।<br />याद करके निकालना <em>ही</em> सीखना है।"</> : <>"Re-reading feels like learning.<br />Recalling <em>is</em> learning."</>}</blockquote>
        <cite>{hi ? '— हर Aspiran पॉड की दीवार पर' : '— on the wall of every Aspiran pod'}</cite>
      </aside>

      <!-- 4. The sky -->
      <section class="scene sky" id="sky-room" data-scene="sky">
        <p class="hud">{hi ? 'कमरा 03 · आसमान जैसा आपका सिलेबस' : 'ROOM 03 · YOUR SYLLABUS, AS A SKY'}</p>
        <h2>{hi ? 'पहले धुंध, फिर तारे।' : 'Fog, then stars.'}</h2>
        <p class="lede">{hi ? <>UPSC सिलेबस की हर पंक्ति एक तारा है। शुरू में अँधेरा है। तारा तभी जलता है जब आप उसे कमा लें।
          स्क्रॉल कीजिए और एक साल बीतता देखिए।</> : <>Every line of the UPSC syllabus is a star. It starts dark. It lights up only when you've earned it.
          Scroll and watch a year go by.</>}</p>
        <div class="sky-wrap" id="sky-wrap">
          <div class="sky-stick">
            <svg id="sky" class="sky-map" viewBox="0 0 1000 560" role="img" aria-label={hi ? 'सितारों के नक़्शे जैसा सिलेबस, साल भर में रोशन होता हुआ' : 'The syllabus as a star map, lighting up over a year'}>
              <g id="sky-lines"></g>
              {sky.map(([paper, en], i) => [paper, hi ? skyHi[i] : en]).map(([paper, topic], i) => (
                <g class="star" data-i={i} data-paper={paper} data-topic={topic} tabindex="0">
                  <circle class="halo" r="14"></circle>
                  <circle class="dot" r="4.5"></circle>
                  <title>{paper} · {topic}</title>
                </g>
              ))}
              <g id="sky-labels"></g>
            </svg>
            <div class="sky-hud">
              <span class="hud" id="sky-month">{hi ? 'महीना 0 · धुंध' : 'MONTH 0 · FOG'}</span>
              <span class="sky-tip" id="sky-tip" aria-live="polite">{hi ? 'किसी तारे पर टैप कीजिए' : 'Tap a star'}</span>
            </div>
            <ul class="legend">
              {hi ? <><li><i class="s met"></i><b>पढ़ लिया</b> एक बार पढ़ा है।</li>
              <li><i class="s recall"></i><b>याद से बता सकते हैं</b> हफ़्ते या ज़्यादा बाद याद से निकाला।</li>
              <li><i class="s use"></i><b>उत्तर में लिख सकते हैं</b> इससे एक उत्तर लिखा।</li></> : <><li><i class="s met"></i><b>Met</b> You've read it once.</li>
              <li><i class="s recall"></i><b>Can recall</b> Pulled from memory a week or more later.</li>
              <li><i class="s use"></i><b>Can use</b> You wrote an answer with it.</li></>}
            </ul>
          </div>
        </div>
        <p class="effect">{hi ? 'कोई "63% पूरा" नहीं। दोबारा पढ़ना झूठा भरोसा दे सकता है। समय नहीं दे सकता, इसीलिए "याद से बता सकते हैं" हफ़्ते भर बाद ही जलता है।' : 'No "63% complete". Re-reading can fake confidence. Time can\'t, which is why "Can recall" only lights up after a week.'}</p>
      </section>

      <!-- 5. The recall -->
      <section class="scene recall" id="recall" data-scene="recall">
        <p class="hud">{hi ? 'कमरा 04 · कमरा 01 याद है?' : 'ROOM 04 · REMEMBER ROOM 01?'}</p>
        <h2>{hi ? 'जल्दी। ऊपर स्क्रॉल मत कीजिए।' : 'Quick. Don\'t scroll up.'}</h2>
        <div class="quiz" data-reveal>
          <p class="q">{hi ? 'उद्देशिका में कितनी बार संशोधन हुआ है?' : 'How many times has the Preamble been amended?'}</p>
          <div class="opts" id="recall-opts">
            <button type="button" data-a="0">{hi ? 'कभी नहीं' : 'Never'}</button>
            <button type="button" data-a="1">{hi ? 'एक बार' : 'Once'}</button>
            <button type="button" data-a="2">{hi ? 'दो बार' : 'Twice'}</button>
            <button type="button" data-a="x">{hi ? 'पता नहीं' : 'No idea'}</button>
          </div>
          <p class="reveal-line" id="recall-out" aria-live="polite" hidden></p>
        </div>
        <p class="effect">{hi ? 'याद से निकालने की यही छोटी-सी कोशिश पूरी तरकीब है। Aspiran इसी पर बना है: पहले आप उत्तर देते हैं, फिर देखते हैं।' : 'That small effort of pulling it out is the whole trick. Aspiran is built around it: you answer first, then you look.'}</p>
      </section>

      <!-- 6. Writing -->
      <section class="scene write" id="write" data-scene="write">
        <p class="hud">{hi ? 'कमरा 05 · मेन्स' : 'ROOM 05 · MAINS'}</p>
        <h2>{hi ? <>शब्द-सीमा के भीतर<br />सधा हुआ तर्क।</> : <>Structured argument<br />under a word limit.</>}</h2>
