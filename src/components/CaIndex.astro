---
// /current-affairs/: every day, newest first, grouped by month, each with its headlines.
import SiteLayout from '../layouts/SiteLayout.astro';
import AppBox from './AppBox.astro';
import CaTray from './viz/CaTray.astro';
import CaWall from './viz/CaWall.astro';
import { type Lang, caDays, longDate, sectionUrl } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const hi = lang === 'hi';
const T = (en: string, h: string) => (hi ? h : en);
const P = hi ? '/hi' : '';
const days = caDays(lang);
const crumbs = [{ name: T('Home', 'होम'), href: `${P}/` }, { name: T('Current affairs', 'करंट अफ़ेयर्स') }];
const title = T('Daily current affairs for UPSC, free', 'UPSC के लिए रोज़ के करंट अफ़ेयर्स, फ़्री');
---

<SiteLayout title={`${title} | Aspiran`} description={T('UPSC current affairs every day: the stories that matter for Prelims and Mains, each tied to the syllabus, with key facts and a practice question. Free, in English and Hindi.',
  'हर दिन UPSC करंट अफ़ेयर्स: प्रीलिम्स और मेन्स के लिए ज़रूरी ख़बरें, सिलेबस से जुड़ी, मुख्य तथ्य और अभ्यास प्रश्न के साथ। फ़्री, हिंदी और अंग्रेज़ी में।')}
  lang={lang} alternates={{ en: sectionUrl('current-affairs', 'en'), hi: sectionUrl('current-affairs', 'hi') }} crumbs={crumbs} current="current-affairs">
  <div class="wrap">
    <header class="sec-head" style="margin-top:8px">
      <p class="kick">{T('Free · updated every morning', 'फ़्री · हर सुबह अपडेट')}</p>
      <h1>{title}</h1>
      <p class="lede">{T('Only what matters for the exam: each story tied to a syllabus line, with why it matters, the facts to remember and a question to check yourself. No 40-page monthly PDFs.',
        'सिर्फ़ वही जो परीक्षा के काम का है: हर ख़बर सिलेबस की एक पंक्ति से जुड़ी, महत्व, याद रखने लायक़ तथ्य और ख़ुद को परखने का सवाल। 40 पेज की मासिक PDF नहीं।')}</p>
    </header>
    {days[0] && <section class="today"><h2>{T(`Latest: ${longDate(days[0].day, lang)}`, `ताज़ा: ${longDate(days[0].day, lang)}`)}</h2><CaTray day={days[0]} lang={lang} link="day" /></section>}
    <CaWall days={days} lang={lang} />
    <div class="narrow"><AppBox lang={lang} where="free-ca-index" feature="ca" /></div>
  </div>
  <div style="height:48px"></div>
</SiteLayout>
