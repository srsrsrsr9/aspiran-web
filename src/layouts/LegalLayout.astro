---
import BaseLayout from './BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<BaseLayout title={`${title} | Aspiran`} description={description}>
  <div class="wrap legal">
    <nav class="nav" aria-label="Site">
      <a class="brand" href="/" aria-label="Aspiran home"><b>Aspiran</b></a>
      <a class="join" href="/">Back to home</a>
    </nav>
    <div class="draftbar">Draft for legal review. Placeholders in [square brackets] must be filled before launch.</div>
    <article class="legal-body">
      <h1 class="h2">{title}</h1>
      <p class="note">Last updated: {updated}</p>
      <slot />
    </article>
    <SiteFooter />
  </div>
</BaseLayout>
