---
import '../../../styles/fonts-hi.css';
import CaDayPage from '../../../components/CaDayPage.astro';
import { caDays } from '../../../lib/content';
export const getStaticPaths = () => caDays('hi').map((day) => ({ params: { day: day.day }, props: { day } }));
const { day } = Astro.props;
---
<CaDayPage day={day} lang="hi" />
