---
import '../../../styles/fonts-hi.css';
import ItemPage from '../../../components/ItemPage.astro';
import { allPages } from '../../../lib/content';
export const getStaticPaths = () => allPages('hi').map((page) => ({ params: { section: page.section, slug: page.slug }, props: { page } }));
const { page } = Astro.props;
---
<ItemPage page={page} lang="hi" />
