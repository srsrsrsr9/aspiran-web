        <nav aria-label="Footer"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href={WA} target="_blank" rel="noopener">WhatsApp</a></nav>
        <p class="small dim">Not affiliated with UPSC. Chotu is an AI and can be wrong. Study content is a draft until our editors check it.</p>
      </footer>
    </main>

    <!-- Chotu's dock: walks down the page with the visitor -->
    <aside class="dock" id="dock" aria-label="Chat with Chotu, an AI" data-open="false">
